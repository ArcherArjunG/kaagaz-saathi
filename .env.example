# Google Cloud project with Vision API, Vertex AI, and Text-to-Speech enabled.
GOOGLE_CLOUD_PROJECT=kaagazsaathi
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash

# Paste the full JSON contents of a GCP service-account key here for the first setup.
# Keep this server-only; never prefix it with NEXT_PUBLIC_.
GCP_SERVICE_ACCOUNT_JSON=

# Required for a public deployment so strangers cannot run up your API bill.
# Choose a long random phrase and enter it in the app when you use it.
APP_ACCESS_CODE=
